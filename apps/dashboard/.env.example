# Read by the dashboard server at request time (not at build time).
# The browser never sees these values. It calls /dashboard-api/*, and the
# server forwards the call to the API.

# Base URL of the FastAPI back end. Compose sets http://api:8000.
API_URL=http://localhost:8000

# Bearer token for /api/*. Must match API_TOKEN of the API. Leave empty when the API is open (dev only).
# API_TOKEN=
