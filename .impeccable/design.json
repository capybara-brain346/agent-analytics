      "kind": "input",
      "refersTo": "input-search",
      "description": "Search a record table.",
      "html": "<div class=\"ds-search\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input aria-label=\"Search agents\" placeholder=\"Search agents\u2026\" /></div>",
      "css": ".ds-search{display:flex;gap:7px;align-items:center;min-width:240px;max-width:450px;background:#1d1c22;border:1px solid #3b3744;border-radius:4px;padding:0 9px;height:31px;color:#9e95ac}.ds-search input{font-family:var(--font-sans,\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif);width:100%;background:transparent;border:0;outline:none;color:#dcd5e5;font-size:10px;caret-color:var(--primary,#bba4ef)}.ds-search input::placeholder{color:#9a9aa8;opacity:1}.ds-search:focus-within{border-color:#af92d6}.ds-search input:focus-visible{outline:0}"
    },
    {
      "name": "Active Navigation",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "Selected destination in the side rail.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item\" href=\"#overview\" aria-current=\"page\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg>Overview</a></nav>",
      "css": ".ds-nav{background:#141417;padding:10px}.ds-nav-item{font-family:var(--font-sans,\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif);position:relative;display:flex;align-items:center;gap:9px;padding:9px 10px;font-size:11px;line-height:1.5;min-height:36px;border-radius:4px;color:#cdb8f3;background:#2c2639;text-decoration:none;transition:background .12s,color .12s}.ds-nav-item::before{content:\"\";height:16px;width:2px;background:var(--primary,#bba4ef);position:absolute;left:-10px;border-radius:1px}.ds-nav-item:hover{background:#232329;color:#e3e3e9}.ds-nav-item:focus-visible{outline:2px solid var(--primary,#bba4ef);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-nav-item{transition:none}}"
