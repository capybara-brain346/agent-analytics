    },
    {
      "name": "Evidence Sheet",
      "kind": "custom",
      "refersTo": "evidence-sheet",
      "description": "Right-side detail layer; this preview shows its head and body.",
      "html": "<section class=\"ds-sheet\" aria-label=\"Request evidence\"><div class=\"ds-sheet-head\"><h2>Request evidence</h2><p>Observed request details</p><button class=\"ds-sheet-close\" aria-label=\"Close\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m18 6-12 12M6 6l12 12\"/></svg></button></div><div class=\"ds-sheet-body\">Identity and task outcome need separate evidence.</div></section>",
      "css": ".ds-sheet{font-family:var(--font-sans,\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif);position:relative;width:610px;max-width:calc(100vw - 34px);background:#1c1b22;border-left:1px solid #51435e;box-shadow:-10px 0 40px #0005;color:var(--foreground,#dedee5)}.ds-sheet-head{position:relative;padding:23px 25px 20px;background:#23202a;border-bottom:1px solid #42364c}.ds-sheet-head h2{margin:0;max-width:90%;font-size:19px;font-weight:550;line-height:1.45;letter-spacing:-.25px;color:#eadcf4}.ds-sheet-head p{margin:10px 0 0;font-size:10px;color:#b6a2c4}.ds-sheet-close{position:absolute;top:12px;right:12px;border:0;border-radius:5px;width:28px;height:28px;background:transparent;color:#bda9cb;display:grid;place-items:center;cursor:pointer}.ds-sheet-close:hover{background:var(--muted,#25252c);color:var(--foreground,#dedee5)}.ds-sheet-close:focus-visible{outline:2px solid var(--primary,#bba4ef);outline-offset:3px;}.ds-sheet-body{overflow-y:auto;padding:20px 25px 30px;font-size:11px}@media(max-width:640px){.ds-sheet{width:100vw;max-width:100vw}.ds-sheet-head{padding:20px 18px 17px}.ds-sheet-head h2{font-size:18px}.ds-sheet-body{padding:17px 18px 25px}}"
    }
  ],
  "narrative": {
    "northStar": "The Evidence Console",
    "overview": "The console uses the user's three dark observability references. Compact controls, aligned numbers, thin borders, and small charts keep records in view. Color marks selection, traffic class, or status.\n\nThe system has no decorative image layer. Panels use a small change in tone. Detail sheets keep the source page visible on wide screens. This record describes the code in `apps/dashboard`; the reference screenshots are review evidence, not shipped assets.",
    "keyCharacteristics": [
      "Dense tables and compact charts.",
      "Charcoal surfaces with fine borders.",
      "Lavender selection and stable traffic class colors.",
      "Evidence labels beside claims and values.",
      "Short state changes and no page-load animation."
