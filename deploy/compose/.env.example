# Optional. Compose works without this file: every value has a default in docker-compose.yml. Copy to .env only to override. Kubernetes uses a Secret or External Secrets.
POSTGRES_USER=agent_analytics
POSTGRES_PASSWORD=agent_analytics
POSTGRES_DB=agent_analytics
LOG_LEVEL=INFO
S3_BUCKET=agent-analytics-inbox
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev-secret
OFFLINE=false
# OPENROUTER_API_KEY=   # with LLM_MODEL set, else template text only
# LLM_MODEL=anthropic/claude-sonnet-5.5
# API_TOKEN=   # Bearer token for /api/*; unset = open (dev only)
